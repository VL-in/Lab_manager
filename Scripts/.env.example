# Copie para .env na mesma pasta que o docker-compose.yml.
# Padrão: Flowise no host na 3000. Se der "port is already allocated", troque para 3001 (ou outra livre).
STREAMLIT_PORT=8501
FLOWISE_PORT=3000
CHROMA_PORT=8000
CHROMA_COLLECTION=lab_docs
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
LMSTUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Opcional (nunca faça commit de valores reais neste arquivo — use só o .env local, fora do Git):
# FLOWISE_CHATFLOW_ID aceita o ID do endpoint de prediction do Flowise:
# - Chatflow: /api/v1/prediction/<id>
# - AgentFlow: /api/v1/prediction/<id>
# Exemplo de stack: AgentFlow no Flowise com LLM local no LM Studio.
#FLOWISE_CHATFLOW_ID=
#FLOWISE_API_KEY=

# ELISA (Excel na aba "Dados ELISA" do Streamlit):
# — Execução local (sem Docker): caminho absoluto na sua máquina.
#ELISA_XLSX_DIR=D:/caminho/absoluto/pasta_com_xlsx
#
# — Docker Compose: o contêiner usa sempre `ELISA_XLSX_DIR=/data/elisa` (definido no compose).
#   Monte a pasta do Windows no host com:
#ELISA_HOST_XLSX_DIR=D:/caminho/absoluto/pasta_com_xlsx
#   Por padrão o compose monta `./Example/results/ELISA` (relativo ao docker-compose.yml).
